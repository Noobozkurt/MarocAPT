{
  "name": "aether3d",
  "version": "2.0.0",
  "private": true,
  "description": "Aether3D — 3D asset & digital product store (storefront, customer area, admin, payments, realtime support chat)",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./.next --ignore ./storage server.ts",
    "build": "prisma generate && next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test --trace off",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@gltf-transform/core": "^4.1.1",
    "@gltf-transform/extensions": "^4.1.1",
    "@gltf-transform/functions": "^4.1.1",
    "@google/model-viewer": "^4.0.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "6.19.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.468.0",
    "meshoptimizer": "^0.22.0",
    "next": "15.5.29",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.7",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "stripe": "^18.5.0",
    "tailwind-merge": "^2.6.0",
    "three": "~0.183.0",
    "tsx": "^4.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^7.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "~0.183.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
